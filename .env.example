# Supabase — ver Documentación/03_DEPLOY.md y Documentación/04_HISTORIAL_CAMBIOS.md (Sesión 13)
# Los valores reales se obtienen en: Supabase Dashboard → Settings → API

# Pública — se expone al navegador. Segura porque el acceso a los datos
# queda restringido por las políticas RLS de cada tabla, no por esta clave.
NEXT_PUBLIC_SUPABASE_URL=

# Pública — misma lógica que la anterior (protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA. Bypassa RLS por completo — solo se usa server-side (Server
# Actions / Route Handlers), nunca en un archivo 'use client', nunca con
# el prefijo NEXT_PUBLIC_. No commitear su valor real en ningún archivo.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Origen público de la app, fijo por entorno — usado para
# construir el redirectTo de las invitaciones de Supabase Auth (nunca se
# infiere de headers de la request ni de datos del cliente).
# Local: http://localhost:3000
# Producción: https://academia-linkamp.vercel.app
SITE_URL=
